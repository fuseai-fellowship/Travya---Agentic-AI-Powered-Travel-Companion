# Copy to .env.local for `npm run dev`. Every VITE_* value is inlined into the public bundle:
# never put secrets here. compose.override.yaml passes the same names to the dev container.
VITE_API_URL=http://localhost:8000
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-travya
# Firebase Auth emulator (firebase emulators:start --only auth). Leave empty to use real Firebase.
VITE_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099

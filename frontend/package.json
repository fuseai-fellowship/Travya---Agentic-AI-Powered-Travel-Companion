    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hookform/resolvers": "^7.0.2",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-router": "^1.170.46",
    "firebase": "^13.2.0",
    "maplibre-gl": "^6.16.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-icons": "^5.7.0",
    "react-map-gl": "^8.1.3",

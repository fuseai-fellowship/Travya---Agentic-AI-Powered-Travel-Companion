# Travya environment variables. Copy to `.env` (git-ignored) and fill in what you need.
#
# - docker compose passes this file to the `api` and `migrate` containers and overrides the
#   infrastructure addresses (DATABASE_URL, REDIS_URL, FIREBASE_AUTH_EMULATOR_HOST, ...) with
#   in-network values, so the defaults below are the ones for running the backend on the host.
# - Production values live in Secret Manager and on the Cloud Run service (infra/terraform);
#   nothing in this file is used in production.
# - Settings are read by backend/app/core/config.py. Empty values are ignored (the default applies).

# ---------------------------------------------------------------------------
# Runtime
# local | test | staging | production (staging/production require the keys checked in config.py)
ENVIRONMENT=local
PROJECT_NAME=Travya
API_V1_PREFIX=/api/v1
# JSON list of browser origins allowed by CORS
FRONTEND_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
LOG_JSON=false
# Error reporting (optional)
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Data
# Postgres 17 + pgvector (compose publishes it on 5433). Neon needs `?sslmode=require` at the end of the URL.
DATABASE_URL=postgresql+psycopg://travya:travya@localhost:5433/travya
DB_POOL_SIZE=5
# Used by pytest only; the compose db creates this database (with pgvector) on first start.
TEST_DATABASE_URL=postgresql+psycopg://travya:travya@localhost:5433/travya_test
# Redis for rate limits and the HTTP cache (Upstash in production: rediss://...). Empty = in-memory.
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Authentication (Firebase). Locally the Auth emulator from compose; never set the emulator host in production.
FIREBASE_PROJECT_ID=demo-travya
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# ---------------------------------------------------------------------------
# LLM (Gemini via Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768
# Global cap on agent runs per day
LLM_DAILY_REQUEST_BUDGET=400

# ---------------------------------------------------------------------------
# Abuse controls (per user, `limits` syntax)
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_PLAN=6/hour
RATE_LIMIT_CHAT=40/hour

# ---------------------------------------------------------------------------
# External services
# true = every adapter (Gemini, maps, weather, images) uses its offline fake; no keys or network needed.
OFFLINE_INTEGRATIONS=true
HTTP_TIMEOUT_SECONDS=15
# HTTP_USER_AGENT defaults to "Travya/1.0 (+<repo url>)"; OpenStreetMap services require a real contact.
HTTP_USER_AGENT=
UNSPLASH_ACCESS_KEY=
ORS_API_KEY=

# ---------------------------------------------------------------------------
# Trip document storage
# local | gcs
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./.storage
GCS_BUCKET=
MAX_UPLOAD_MB=10

# ---------------------------------------------------------------------------
# Frontend build-time variables (frontend/.env.local for `npm run dev` on the host; GitHub
# variables for production builds). Vite inlines them into the public bundle: never put secrets here.
# Compose sets its own values for the web container.
VITE_API_URL=http://localhost:8000
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-travya.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-travya
# Local only: leave empty for production builds
VITE_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099
